{
  "name": "bridgify-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/size-check.mjs && node scripts/csp-check.mjs && node scripts/content-check.mjs",
