    "@huggingface/transformers": "4.3.2",
    "@mediapipe/tasks-vision": "1.2.3",
    "idb-keyval": "6.3.0",
    "lucide-react": "^1.79.0",
    "motion": "14.14.0",
    "peerjs": "1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.6",
    "socket.io-client": "4.8.4",
